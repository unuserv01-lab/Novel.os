# Copy to .env and export in your shell. NEVER commit real keys.
NOVELOS_HOME=data
# mock = offline & free (default). gemini | openrouter = real providers (text verified live 2026-11-14).
# pollinations = free image generation, no key (verified live 2026-11-14).
NOVELOS_TEXT_PROVIDER=mock
NOVELOS_IMAGE_PROVIDER=mock
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Model names are guesses: check the provider's current model list and override.
# gemini-2.5-flash / gemini-2.5-flash-image are retired for new users (404); use the 3.x models below.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Pollinations image model (free, no key). flux is the default; turbo is faster, lower quality.
POLLINATIONS_MODEL=flux
# Budget guard (USD, estimates you set yourself; 0 = free tier). Regeneration is capped regardless.
NOVELOS_MAX_REGEN=2
NOVELOS_MAX_COST_USD=0.50
NOVELOS_EST_COST_TEXT=0
NOVELOS_EST_COST_IMAGE=0
